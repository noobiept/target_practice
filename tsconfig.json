{
    "compilerOptions": {
        "target": "ES2018",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "DOM",
            "ES2018"
        ],
        "useDefineForClassFields": false,
        "types": [
            "vite/client"
        ],
        "strict": false,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": [
        "source/**/*.ts"
    ]
}
